
# EventHub local environment configuration
# Copy this file to .env and fill in your own secrets.
# Never commit .env to Git.

# MySQL database connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_PASSWORD=
MYSQL_DATABASE=aether_db

# Flask session signing key
# Generate a secure random value before running the app.
SECRET_KEY=

# SQLAlchemy configuration is currently separate from
# the existing MySQL Connector repository.
# Do not run migrations against aether_db yet.
