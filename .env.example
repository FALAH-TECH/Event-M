# Copy to .env for local use; never commit or share the populated file.
# MYSQL_HOST, MYSQL_PORT, MYSQL_USER and MYSQL_DATABASE have the local defaults
# shown below. Point test writes at a separate database, never aether_db.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_DATABASE=aether_db

# Required: set these locally to the database password and a long random,
# unique Flask session secret. Keep both out of source control and logs.
MYSQL_PASSWORD=
FLASK_SECRET_KEY=

# For hosted environments, inject secrets through the hosting provider's
# secret manager; do not use this file to store deployment credentials.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///eventhub.db